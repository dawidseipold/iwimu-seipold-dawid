{
  "nazwa": "Dobór kawy",
  "cel": "kawa",
  "atrybuty": {
    "temperatura": {"typ": "liczba", "pytanie": "Jaka jest temperatura (°C)?", "zakres": [-30, 45]},
    "pora_dnia": {"typ": "wybor", "pytanie": "Jaka jest pora dnia?", "wartosci": ["rano", "popołudnie", "wieczór"]},
    "dodatek": {"typ": "wybor", "pytanie": "Jaki dodatek?", "wartosci": ["mleko", "czekolada", "brak"]},
    "kofeina_ok": {"typ": "wybor", "pytanie": "Czy kofeina jest OK?", "wartosci": ["tak", "nie"]},
    "rodzaj_kawy": {"typ": "wniosek", "wartosci": ["zimna", "gorąca"]},
    "moc": {"typ": "wniosek", "wartosci": ["mocna", "łagodna", "bezkofeinowa"]},
    "kawa": {"typ": "wniosek", "wartosci": ["mrożona kawa bezkofeinowa", "latte bezkofeinowe", "chocolate cold coffee", "iced latte", "cold brew", "mocha", "latte", "americano", "espresso"]}
  },
  "reguly": [
    {"id": "R1", "jesli": [["temperatura", ">", 22]], "to": ["rodzaj_kawy", "zimna"],
     "metafora": "Jest ciepło, więc kawa na zimno."},
    {"id": "R2", "jesli": [["temperatura", "<=", 22]], "to": ["rodzaj_kawy", "gorąca"],
     "metafora": "Jest chłodno, więc kawa na gorąco."},
    {"id": "R3", "jesli": [["kofeina_ok", "==", "nie"]], "to": ["moc", "bezkofeinowa"],
     "metafora": "Kto nie chce kofeiny, dostaje bezkofeinową."},
    {"id": "R4", "jesli": [["kofeina_ok", "==", "tak"], ["pora_dnia", "==", "rano"]], "to": ["moc", "mocna"],
     "metafora": "Rano mocna kawa stawia na nogi."},
    {"id": "R5", "jesli": [["pora_dnia", "==", "wieczór"]], "to": ["moc", "bezkofeinowa"],
     "metafora": "Wieczorem kofeina psuje sen."},
    {"id": "R6", "jesli": [["kofeina_ok", "==", "tak"], ["pora_dnia", "==", "popołudnie"]], "to": ["moc", "łagodna"],
     "metafora": "Po południu wystarczy łagodna kawa."},
    {"id": "R7", "jesli": [["rodzaj_kawy", "==", "zimna"], ["moc", "==", "bezkofeinowa"]], "to": ["kawa", "mrożona kawa bezkofeinowa"],
     "metafora": "Na zimno i bez kofeiny.", "coto": "Schłodzona kawa bezkofeinowa z lodem."},
    {"id": "R8", "jesli": [["rodzaj_kawy", "==", "gorąca"], ["moc", "==", "bezkofeinowa"]], "to": ["kawa", "latte bezkofeinowe"],
     "metafora": "Na gorąco i bez kofeiny.", "coto": "Latte na kawie bezkofeinowej."},
    {"id": "R9", "jesli": [["rodzaj_kawy", "==", "zimna"], ["dodatek", "==", "czekolada"]], "to": ["kawa", "chocolate cold coffee"],
     "metafora": "Na zimno i z czekoladą.", "coto": "Schłodzona kawa z czekoladą."},
    {"id": "R10", "jesli": [["rodzaj_kawy", "==", "zimna"], ["dodatek", "==", "mleko"]], "to": ["kawa", "iced latte"],
     "metafora": "Na zimno i z mlekiem.", "coto": "Espresso z zimnym mlekiem i lodem."},
    {"id": "R11", "jesli": [["rodzaj_kawy", "==", "zimna"], ["dodatek", "==", "brak"]], "to": ["kawa", "cold brew"],
     "metafora": "Na zimno i czarna.", "coto": "Kawa parzona na zimno przez kilkanaście godzin."},
    {"id": "R12", "jesli": [["rodzaj_kawy", "==", "gorąca"], ["dodatek", "==", "czekolada"]], "to": ["kawa", "mocha"],
     "metafora": "Na gorąco i z czekoladą.", "coto": "Espresso z czekoladą i mlekiem."},
    {"id": "R13", "jesli": [["rodzaj_kawy", "==", "gorąca"], ["dodatek", "==", "mleko"]], "to": ["kawa", "latte"],
     "metafora": "Na gorąco i z mlekiem.", "coto": "Espresso z dużą ilością spienionego mleka."},
    {"id": "R14", "jesli": [["rodzaj_kawy", "==", "gorąca"], ["dodatek", "==", "brak"], ["moc", "==", "łagodna"]], "to": ["kawa", "americano"],
     "metafora": "Czarna, ale łagodna.", "coto": "Espresso rozcieńczone gorącą wodą."},
    {"id": "R15", "jesli": [["rodzaj_kawy", "==", "gorąca"], ["dodatek", "==", "brak"], ["moc", "==", "mocna"]], "to": ["kawa", "espresso"],
     "metafora": "Czarna i mocna.", "coto": "Mała, mocna kawa z ekspresu ciśnieniowego."}
  ]
}
